{
  "name": "tarmac",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo/ui": "~57.0.26",
    "@notifee/react-native": "^9.1.8",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.22",
    "expo-router": "~57.0.29",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-bluetooth-classic": "^1.73.0-rc.17",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eas-cli": "^25.3.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.6",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild --clean",
    "run:android": "expo run:android",
    "run:ios": "expo run:ios",
    "eas:login": "eas-cli login",
    "eas:init": "eas-cli init",
    "build:apk": "eas-cli build --platform android --profile preview",
    "build:dev:android": "eas-cli build --platform android --profile development",
    "build:dev:ios": "eas-cli build --platform ios --profile development",
    "build:prod:android": "eas-cli build --platform android --profile production",
    "build:prod:ios": "eas-cli build --platform ios --profile production",
    "update:configure": "eas-cli update:configure",
    "update:preview": "eas-cli update --branch preview",
    "update:prod": "eas-cli update --branch production",
    "doctor": "expo-doctor"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|react-native-mmkv|react-native-ble-plx|zustand)"
    ],
    "collectCoverageFrom": [
      "src/elm/**/*.ts",
      "src/obd/**/*.ts",
      "src/transport/**/*.ts",
      "src/connection/**/*.ts",
      "src/run/**/*.ts"
    ]
  }
}
