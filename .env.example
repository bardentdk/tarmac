# Variables publiques : Vite les embarque dans le JavaScript servi au navigateur.
# Rien de secret ici (ni DATABASE_URL, ni clé Resend, ni jeton Cloudflare).
VITE_TARMAC_API_URL=
VITE_TARMAC_PUBLISHABLE_KEY=
VITE_TARMAC_DB_SCHEMA=
VITE_TARMAC_API_TIMEOUT_MS=

# Lien de téléchargement de l'app (build EAS « preview » en distribution interne).
VITE_ANDROID_DOWNLOAD_URL=
VITE_APP_VERSION=
VITE_IOS_DOWNLOAD_URL=

# Lu par le serveur de dev uniquement (proxy /auth) : jamais embarqué.
TARMAC_AUTH_URL=
