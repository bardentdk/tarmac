{
  "expo": {
    "name": "Tarmac",
    "slug": "Tarmac",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tarmac",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0F11",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "bundleIdentifier": "fr.tarmac.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Tarmac utilise le Bluetooth pour parler au boîtier branché sur la prise OBD de ta voiture. Sans cette autorisation, impossible de lire le régime, la vitesse ou les températures.",
        "NSBluetoothPeripheralUsageDescription": "Tarmac utilise le Bluetooth pour parler au boîtier branché sur la prise OBD de ta voiture.",
        "NSLocalNetworkUsageDescription": "Certains boîtiers OBD créent leur propre réseau Wi-Fi. Tarmac a besoin d'accéder au réseau local pour s'y connecter.",
        "NSLocationWhenInUseUsageDescription": "Le GPS sert à chronométrer tes runs au centième et à calculer ta vitesse réelle, indépendamment du compteur.",
        "UIBackgroundModes": [
          "bluetooth-central",
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.tarmac.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E0F11",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0F11",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "Tarmac utilise le Bluetooth pour parler au boîtier OBD de ta voiture."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Le GPS sert à chronométrer tes runs au centième.",
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a05d7632-1c68-4ce8-93c7-0d1288b912ca"
      }
    }
  }
}
